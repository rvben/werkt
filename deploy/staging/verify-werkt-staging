#!/usr/bin/env bash
set -euo pipefail
umask 0077

if [[ $EUID -ne 0 ]]; then
  echo "verify-werkt-staging must run as root" >&2
  exit 1
fi
if [[ $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: verify-werkt-staging COMMIT" >&2
  exit 2
fi

expected_commit=$1
environment_file=/etc/werkt/werkt.env
if [[ ! -f $environment_file ]]; then
  echo "missing $environment_file" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$environment_file"
set +a
: "${WERKT_MANAGEMENT_TOKEN:?missing WERKT_MANAGEMENT_TOKEN in $environment_file}"
: "${WERKT_SECRET_KEY:?missing WERKT_SECRET_KEY in $environment_file}"
: "${WERKT_STAGING_CANARY_AUTOMATION:?missing WERKT_STAGING_CANARY_AUTOMATION in $environment_file}"
if [[ ! $WERKT_MANAGEMENT_TOKEN =~ ^[A-Za-z0-9_-]{32,}$ ]]; then
  echo "WERKT_MANAGEMENT_TOKEN has an unsafe format" >&2
  exit 1
fi
if [[ ! $WERKT_STAGING_CANARY_AUTOMATION =~ ^[a-z][a-z0-9-]{0,62}$ ]]; then
  echo "WERKT_STAGING_CANARY_AUTOMATION has an unsafe format" >&2
  exit 1
fi

temporary_directory=$(mktemp -d)
trap 'rm -rf -- "$temporary_directory"' EXIT
authorization_config=$temporary_directory/authorization.curl
printf 'header = "Authorization: Bearer %s"\n' "$WERKT_MANAGEMENT_TOKEN" > "$authorization_config"
unset WERKT_MANAGEMENT_TOKEN

request() {
  curl --silent --show-error --connect-timeout 2 --max-time 10 "$@"
}

ready_status=$(request -o "$temporary_directory/ready.json" -w '%{http_code}' http://127.0.0.1:8080/readyz)
if [[ $ready_status != 200 ]] || ! grep -Fq "\"commit\":\"$expected_commit\"" "$temporary_directory/ready.json"; then
  echo "local readiness did not report expected commit $expected_commit" >&2
  exit 1
fi

unauthorized_status=$(request -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/api/v1/automations)
if [[ $unauthorized_status != 401 ]]; then
  echo "management API accepted an unauthenticated request: HTTP $unauthorized_status" >&2
  exit 1
fi

authorized_status=$(request --config "$authorization_config" -o /dev/null -w '%{http_code}' \
  http://127.0.0.1:8080/api/v1/automations)
if [[ $authorized_status != 200 ]]; then
  echo "host-local authenticated inventory returned HTTP $authorized_status" >&2
  exit 1
fi

session_status=$(request -o "$temporary_directory/session.json" -w '%{http_code}' \
  http://127.0.0.1:8080/api/v1/auth/session)
if [[ $session_status != 200 ]] \
  || ! grep -Fq '"environment":"staging"' "$temporary_directory/session.json" \
  || ! grep -Fq '"instance":"staging-control"' "$temporary_directory/session.json"; then
  echo "operator scope is not staging/staging-control" >&2
  exit 1
fi

recovery_json=$(runuser --user werkt --preserve-environment -- /usr/local/bin/werkt recovery verify)
if [[ $recovery_json != *'"database": "ok"'* || $recovery_json != *'"artifactsVerified"'* ]]; then
  echo "database, vault, and artifact recovery verification failed" >&2
  exit 1
fi

canary_status=$(request --config "$authorization_config" -o "$temporary_directory/canary.json" -w '%{http_code}' \
  "http://127.0.0.1:8080/api/v1/automations/$WERKT_STAGING_CANARY_AUTOMATION")
if [[ $canary_status != 200 ]] || ! grep -Eq '"artifactDigest":"sha256:[a-f0-9]{64}"' "$temporary_directory/canary.json"; then
  echo "staging canary has no active attested artifact" >&2
  exit 1
fi
if ! grep -Eq '"image":"[^"]+@sha256:[a-f0-9]{64}"' "$temporary_directory/canary.json"; then
  echo "staging canary runtime image is not digest-pinned" >&2
  exit 1
fi
active_revision=$(sed -n 's/.*"activeRevisionId":"\([^"]*\)".*/\1/p' "$temporary_directory/canary.json" | head -1)
if [[ ! $active_revision =~ ^rev_[a-f0-9]{24}$ ]]; then
  echo "staging canary returned an invalid active revision" >&2
  exit 1
fi

canary_key="staging-${expected_commit}"
run_status=$(request --config "$authorization_config" -o "$temporary_directory/run-created.json" -w '%{http_code}' \
  -X POST -H 'Content-Type: application/json' -H 'X-Werkt-Actor: staging:provenance-gate' \
  -H "Idempotency-Key: $canary_key" -H "X-Werkt-Expected-Revision: $active_revision" \
  --data '{}' "http://127.0.0.1:8080/api/v1/automations/$WERKT_STAGING_CANARY_AUTOMATION/runs")
if [[ $run_status != 200 && $run_status != 202 ]]; then
  echo "staging canary run was not accepted: HTTP $run_status" >&2
  exit 1
fi
run_id=$(sed -n 's/.*"runId":"\([^"]*\)".*/\1/p' "$temporary_directory/run-created.json" | head -1)
if [[ ! $run_id =~ ^run_[a-f0-9]+$ ]]; then
  echo "staging canary returned an invalid run ID" >&2
  exit 1
fi

canary_succeeded=false
for _ in {1..30}; do
  request --config "$authorization_config" -o "$temporary_directory/run.json" \
    "http://127.0.0.1:8080/api/v1/runs/$run_id"
  if grep -Fq '"status":"succeeded"' "$temporary_directory/run.json"; then
    canary_succeeded=true
    break
  fi
  if grep -Fq '"status":"failed"' "$temporary_directory/run.json"; then
    echo "staging canary execution failed" >&2
    exit 1
  fi
  sleep 1
done
if [[ $canary_succeeded != true ]]; then
  echo "staging canary did not succeed within 30 seconds" >&2
  exit 1
fi

echo "host-local authenticated staging and provenance checks passed"
