[Unit]
Description=Werkt staging PostgreSQL
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/etc/werkt
ExecStart=/usr/bin/docker compose -f /etc/werkt/postgres.compose.yml up -d --wait
ExecStop=/usr/bin/docker compose -f /etc/werkt/postgres.compose.yml down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
