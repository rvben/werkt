HOME=/var/lib/werkt
PGPASSFILE=/etc/werkt/pgpass

WERKT_DATABASE_URL=postgres://werkt@127.0.0.1:5432/werkt?sslmode=disable
WERKT_DATA_DIR=/var/lib/werkt/data
WERKT_LISTEN_ADDR=127.0.0.1:8080
WERKT_ENVIRONMENT=staging
WERKT_INSTANCE=staging-control
WERKT_MANAGEMENT_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
WERKT_SECRET_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY
WERKT_STAGING_CANARY_AUTOMATION=REPLACE_WITH_A_HARMLESS_PRIVATE_CANARY

WERKT_EXECUTOR=husker
WERKT_HUSKER_URL=http://127.0.0.1:17777
WERKT_HUSKER_TOKEN=REPLACE_WITH_THE_HUSKER_API_TOKEN
WERKT_HUSKER_VCPUS=1
WERKT_HUSKER_MEMORY_MIB=256
WERKT_HUSKER_BUILD_NETWORK=nat

# runtime.tools preparation. The base is a local Husker catalog image, not an
# OCI reference. Pin both it and the host-provisioned mise binary by SHA-256.
WERKT_HUSKER_TOOL_BASE_IMAGE=REPLACE_WITH_A_LOCAL_HUSKER_BASE_IMAGE
WERKT_HUSKER_TOOL_BASE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
WERKT_HUSKER_TOOL_PLATFORM=linux-amd64
WERKT_HUSKER_MISE_PATH=/opt/werkt/bin/mise
WERKT_HUSKER_MISE_VERSION=REPLACE_WITH_AN_EXACT_VERSION
WERKT_HUSKER_MISE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
WERKT_HUSKER_TOOL_PREPARE_TIMEOUT=20m

WERKT_SHUTDOWN_PERIOD=20s
WERKT_DEPLOY_TIMEOUT=30m
WERKT_DEPLOYMENT_POLL=500ms
WERKT_MAX_PACKAGE_BYTES=67108864
WERKT_MAX_EXPANDED_PACKAGE_BYTES=268435456
WERKT_MAX_PACKAGE_ENTRIES=10000
